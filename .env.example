# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA vai para o Git.

# --- PostgreSQL local (docker-compose) ---
POSTGRES_USER=helpboard
POSTGRES_PASSWORD=helpboard_dev
POSTGRES_DB=helpboard
POSTGRES_PORT=5432

# --- API ---
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+psycopg://helpboard:helpboard_dev@localhost:5432/helpboard
TEST_DATABASE_URL=postgresql+psycopg://helpboard:helpboard_dev@localhost:5432/helpboard_test

# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do frontend permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Seed ---
# Senha dos usuários de demonstração (admin@, maria@, carlos@, joao@helpboard.dev)
DEMO_PASSWORD=helpboard123
